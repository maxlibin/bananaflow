# Postgres (docker compose up -d starts one with these credentials)
DATABASE_URL=postgresql://bananaflow:bananaflow@localhost:5432/bananaflow

# Origin of this app. Used to build asset URLs and to fetch your own uploads.
APP_ORIGIN=http://localhost:3000

# Encrypts provider keys saved on the Settings page. Generate: openssl rand -hex 32
APP_SECRET=

# Optional server-wide provider keys, used when no key is saved in Settings.
# Google AI Studio: Nano Banana image models and Veo 3.1 video.
GOOGLE_API_KEY=
# OpenAI: GPT Image models and Sora 2 video.
OPENAI_API_KEY=

# Runs the job pollers and bulk queue inside the Next.js server.
# Set to "false" and call /api/cron/* from an external scheduler instead.
ENABLE_INPROCESS_SCHEDULER=true

# Protects /api/cron/* when an external scheduler calls them. Generate: openssl rand -hex 32
CRON_SECRET=

# Optional: public origin of this app, used only by providers that deliver
# results by webhook. Leave empty; the scheduler polls the providers instead.
PUBLIC_BASE_URL=

# Optional: S3-compatible storage (R2, S3, MinIO). Leave all empty for local disk under ./data/uploads.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
